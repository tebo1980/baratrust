# BaraTrust Environment Configuration Example
# Copy to .env.local for local development. Never commit real keys or operator credentials.

# Database (Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Authorized BaraTrust Operators (Todd & Noelah)
# Supply Noelah's (and Todd's) verified Clerk User IDs (user_...) and/or verified Clerk emails:
OPERATOR_CLERK_USER_IDS=""
OPERATOR_EMAILS="todd@baratrust.com"
OPERATOR_NOTIFICATION_EMAIL="todd@baratrust.com"

# Optional AI Assist (Gemini)
GEMINI_API_KEY=""

# Optional Follow-Up Claim HMAC Secret (falls back to server secret if unset)
FOLLOWUP_CLAIM_SECRET=""

# Phase C: Customer Receptionist & Hunter Pull-Sync Controls
# Explicit enablement gate for automated customer acknowledgment emails (MUST remain "false" until human approval):
CUSTOMER_AUTO_ACK_ENABLED="false"
# Response-time commitment (1 or 2 business days; defaults to 2 until 1-day coverage is confirmed):
CUSTOMER_RESPONSE_BUSINESS_DAYS="2"
# Shared high-entropy secret (>= 32 chars) authenticating Hunter's local pull sync (GET /api/customer-inquiries/sync):
HUNTER_INQUIRY_SYNC_SECRET=""
# Verified BaraTrust Google Calendar appointment schedule (optional; falls back to manual coordination if unset):
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3pyieVpWz4IMI9eQ1Po0Me9ONKS8LBn5go3Z79mGnzsDoSyBN9fz5Iqdxh20AWs5HF9gkQjBmU"
# Optional outbound email transport for preapproved customer acknowledgments:
# Preferred serverless HTTPS API (Resend) or direct TLS 465 SMTP fallback:
RESEND_API_KEY=""
TRANSACTIONAL_FROM_EMAIL="Todd & Noelah — BaraTrust <todd@baratrust.com>"
CPANEL_SMTP_HOST="server221.web-hosting.com"
CPANEL_SMTP_PORT="465"
CPANEL_SMTP_USER="todd@baratrust.com"
CPANEL_SMTP_PASS=""
