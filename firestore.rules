rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // [PILLAR 3] Path Variable Hardening & Global Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // [PILLAR 0] Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // [PILLAR 2] Validation Helper for Contractor
    function isValidContractor(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.regions is list && data.regions.size() <= 10
        && data.categories is list && data.categories.size() <= 10;
    }

    match /contractors/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidContractor(incoming()) 
        && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidContractor(incoming())
        && incoming().uid == userId;
    }

    // [PILLAR 2] Validation Helper for JobLead
    function isValidLead(data) {
      return data.title is string && data.title.size() <= 200
        && data.contractorId is string && data.contractorId.size() <= 128
        && data.region is string && data.region.size() <= 100
        && data.sourceUrl is string && data.sourceUrl.size() <= 2048;
    }

    match /leads/{leadId} {
      // [PILLAR 8] Secure List Queries
      allow list: if isSignedIn() && resource.data.contractorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.contractorId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidLead(incoming()) 
        && incoming().contractorId == request.auth.uid;
      
      allow update: if isSignedIn() && isValidLead(incoming())
        && existing().contractorId == request.auth.uid
        && incoming().contractorId == request.auth.uid
        && (
          // [PILLAR 4] Action-Based Update: Status change
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      
      allow delete: if isSignedIn() && resource.data.contractorId == request.auth.uid;
    }

    match /searchLogs/{logId} {
      allow list: if isSignedIn() && resource.data.contractorId == request.auth.uid;
      allow create: if isSignedIn() && incoming().contractorId == request.auth.uid;
    }
  }
}
